<Window x:Class="ShareDash.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShareDash.Windows.ViewModels"
        xmlns:conv="clr-namespace:ShareDash.Windows.Converters"
        mc:Ignorable="d"
        Title="ShareDash"
        Height="650" Width="840"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextWhiteBrush}"
        FontFamily="Segoe UI, Aptos, Arial">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Radar Pulse Waves with Smooth Spring Easing -->
        <Storyboard x:Key="RadarPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="2.3" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="2.3" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1" Storyboard.TargetProperty="Opacity" From="0.5" To="0.0" Duration="0:0:3.2"/>

            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="2.3" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="2.3" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity" From="0.5" To="0.0" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
        </Storyboard>

        <!-- Ambient Specular Shimmer Breathing -->
        <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.65" Duration="0:0:4.5"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlowScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.08" Duration="0:0:5"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlowScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.08" Duration="0:0:5"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource RadarPulseStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource ShimmerStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Outer Window Border with Smooth Apple Glass Curvature -->
    <Border Background="{StaticResource SmoothMidnightBgGradient}" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.2" CornerRadius="26" ClipToBounds="True">
        <Grid>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  SILKY SMOOTH AMBIENT SHIMMER (BANDING-FREE)                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid IsHitTestVisible="False">
                <!-- Center Luminous Cyan-Teal Glow Pool -->
                <Ellipse x:Name="CenterGlow" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CenterGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#2A00FFA3" Offset="0"/>
                            <GradientStop Color="#3000D2FF" Offset="0.3"/>
                            <GradientStop Color="#141E40AF" Offset="0.65"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  MAIN APP LAYOUT                                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Minimal Title Bar (Drag Window) -->
                    <RowDefinition Height="56"/>
                    <!-- Central Content -->
                    <RowDefinition Height="*"/>
                    <!-- Minimal Bottom Status -->
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  TOP BAR (Clean, no clutter, no false badges)           -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Margin="24,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimal Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource CyanGreenGradient}" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFA3" BlurRadius="12" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#040711"/>
                        </Border>
                        <TextBlock Text="ShareDash" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top Bubbly Dynamic Alert (Shows ONLY when Bluetooth is actually OFF) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBluetoothOff, Converter={StaticResource BoolToVis}}" Background="#221208" BorderBrush="{StaticResource AlertAmberBrush}" BorderThickness="1.2" CornerRadius="16" Padding="14,6">
                        <Border.Effect>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="16" Opacity="0.35" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️ Bluetooth is off" FontSize="12" Foreground="{StaticResource AlertAmberBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource BouncyPillButton}" Content="Turn On" Command="{Binding TurnOnBluetoothCommand}" Height="26" Padding="12,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Control Buttons (Minimize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Minimize_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Content="🗕" Cursor="Hand" FontSize="12" Margin="0,0,4,0"/>
                        <Button Click="Close_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Content="✕" Cursor="Hand" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 1: SCANNING STATE (ON OPEN)                      -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <!-- Radar Pulse Animation -->
                        <RowDefinition Height="220"/>
                        <!-- Scanning Title & Subtext -->
                        <RowDefinition Height="Auto"/>
                        <!-- Discovered Devices List -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Radar Pulse Container -->
                    <Grid Grid.Row="0" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pulse Ring 1 -->
                        <Border x:Name="PulseRing1" Width="96" Height="96" CornerRadius="48" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PulseRing1Scale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Pulse Ring 2 -->
                        <Border x:Name="PulseRing2" Width="96" Height="96" CornerRadius="48" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PulseRing2Scale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Center Apple Glass Dome Node -->
                        <Border Width="76" Height="76" CornerRadius="38" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFA3" BlurRadius="26" Opacity="0.55" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Top Gloss Sheen Reflection -->
                                <Border VerticalAlignment="Top" Height="36" CornerRadius="38,38,0,0" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                                <TextBlock Text="⚡" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource NeonGreenBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Title & Discoverable Info -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,18">
                        <TextBlock Text="Searching for ShareDash devices..." FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusSubtext}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Discovered Devices: Apple-Style Bubbly Floating Cards -->
                    <StackPanel Grid.Row="2" Width="460" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BubblyDeviceCardButton}" Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Device Glass Bubble Icon -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#17243A" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Device Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                                <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <!-- Connect Pill -->
                                            <Border Grid.Column="2" Background="{StaticResource CyanGreenGradient}" CornerRadius="14" Padding="14,7" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00FFA3" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                                </Border.Effect>
                                                <TextBlock Text="Connect →" FontSize="11" FontWeight="Bold" Foreground="#040711"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 2: CONNECTING ANIMATION                          -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="92" Height="92" CornerRadius="46" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D2FF" BlurRadius="30" Opacity="0.65" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <Border VerticalAlignment="Top" Height="44" CornerRadius="46,46,0,0" Background="{StaticResource GlassSheenBrush}"/>
                                <TextBlock Text="🔗" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ActiveDevice.Name, StringFormat='Connecting to {0}...'}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Exchanging session keys &amp; aggregating channels..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 3: CONNECTED (DRAG FILES TO BE TRANSFERRED)      -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Width="560">
                        <!-- Connected Device Header Pill -->
                        <Border Style="{StaticResource AppleGlassCard}" Margin="0,0,0,16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ActiveDevice.Icon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Connected to " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ActiveDevice.Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="⚡ Line speed ready • 0% Router Overhead" FontSize="11" Foreground="{StaticResource NeonCyanBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BouncySubtleButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" Height="30" Padding="12,0" FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Large Bubbly Dropzone with Reflective Sheen -->
                        <Border Background="#0E1628" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1.5" CornerRadius="24" Padding="40,48" AllowDrop="True" Drop="Dropzone_Drop" DragOver="Dropzone_DragOver" Cursor="Hand" MouseLeftButtonUp="Dropzone_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFA3" BlurRadius="28" Opacity="0.22" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <TextBlock Text="Drag files to be transferred" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop any file or folder here to share at line speed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,18"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource BouncyPillButton}" Content="Browse Files" Command="{Binding SelectFilesCommand}" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource BouncySubtleButton}" Content="Browse Folder" Command="{Binding SelectFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 4: ACTIVE TRANSFER (SAME AS PHONE SCREEN)        -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource AppleGlassCard}" Width="520" Padding="34">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Large Digital Line Speed -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSpeedMbS}" FontSize="56" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                <TextBlock Text=" MB/s" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}" VerticalAlignment="Bottom" Margin="4,0,0,12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentSpeedGbps, StringFormat='{}⚡ {0:F2} Gbps Fast-Path Line Speed'}" FontSize="13" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" Margin="0,-6,0,22"/>

                            <!-- File Name -->
                            <TextBlock Text="{Binding CurrentFileName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" Margin="0,0,0,12"/>

                            <!-- Apple Glowing Progress Bar -->
                            <ProgressBar Style="{StaticResource AppleProgressBar}" Value="{Binding ProgressPercentage}" Height="10" Width="440" Margin="0,0,0,16"/>

                            <!-- Progress Metrics -->
                            <Grid Width="440" Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding FormattedTransferred}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding FormattedTotal}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{} ({0:F1}%)'}" FontSize="12" Foreground="{StaticResource NeonGreenBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding EtaTimeFormatted, StringFormat='{}ETA: {0}'}" FontSize="12" Foreground="{StaticResource NeonCyanBrush}"/>
                            </Grid>

                            <!-- Channel Badges -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Border Background="#152136" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding UsbSpeedMbS, StringFormat='{}⚡ USB: {0} MB/s'}" FontSize="11" Foreground="{StaticResource NeonGreenBrush}"/>
                                </Border>
                                <Border Background="#152136" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                    <TextBlock Text="{Binding WifiSpeedMbS, StringFormat='{}📶 Wi-Fi: {0} MB/s'}" FontSize="11" Foreground="{StaticResource NeonCyanBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource BouncySubtleButton}" Content="Cancel Transfer" Command="{Binding CancelTransferCommand}" HorizontalAlignment="Center" Height="34"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 5: COMPLETED STATE                               -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource AppleGlassCard}" Width="480" Padding="34">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="34" Background="#102A24" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FFA3" BlurRadius="24" Opacity="0.55" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Transfer Complete!" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LatestResult.FileName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                            <!-- Summary Card -->
                            <Border Background="#0E1628" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,22">
                                <Grid Width="380">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="SIZE" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.SizeMb, StringFormat='{}{0:F1} MB'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="TIME" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.TimeSecs, StringFormat='{}{0:F1}s'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="AVG SPEED" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.AvgSpeedMbS, StringFormat='{}{0:F1} MB/s'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="✓ Integrity Verified with BLAKE3 &amp; CRC32" FontSize="11" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BouncyPillButton}" Content="Send More Files" Command="{Binding SelectFilesCommand}" Margin="0,0,12,0"/>
                                <Button Style="{StaticResource BouncySubtleButton}" Content="Done" Command="{Binding BackToScanningCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  BOTTOM MINIMAL FOOTER                                  -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="28,0">
                    <TextBlock Text="Plug your phone with USB-C cable for faster share." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

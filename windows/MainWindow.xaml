<Window x:Class="ShareDash.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ShareDash.Windows.ViewModels"
        xmlns:conv="clr-namespace:ShareDash.Windows.Converters"
        xmlns:ctrl="clr-namespace:ShareDash.Windows.Controls"
        mc:Ignorable="d"
        Title="ShareDash"
        Height="680" Width="860"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextWhiteBrush}"
        FontFamily="Segoe UI, Aptos, Arial">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Radar Pulse Waves with Smooth Spring Easing -->
        <Storyboard x:Key="RadarPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="2.3" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="2.3" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1" Storyboard.TargetProperty="Opacity" From="0.5" To="0.0" Duration="0:0:3.2"/>

            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleX" From="0.75" To="2.3" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2Scale" Storyboard.TargetProperty="ScaleY" From="0.75" To="2.3" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity" From="0.5" To="0.0" BeginTime="0:0:1.6" Duration="0:0:3.2"/>
        </Storyboard>

        <!-- Ambient Specular Shimmer Breathing -->
        <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CenterGlow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.65" Duration="0:0:4.5"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlowScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.08" Duration="0:0:5"/>
            <DoubleAnimation Storyboard.TargetName="CenterGlowScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.08" Duration="0:0:5"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource RadarPulseStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource ShimmerStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Outer Window Border with Smooth Apple Glass Curvature -->
    <Border Background="{StaticResource SmoothMidnightBgGradient}" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.2" CornerRadius="26" ClipToBounds="True">
        <Grid>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  SILKY SMOOTH AMBIENT SHIMMER (BANDING-FREE)                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid IsHitTestVisible="False">
                <!-- Center Luminous Cyan-Teal Glow Pool -->
                <Ellipse x:Name="CenterGlow" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CenterGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#2A00FFA3" Offset="0"/>
                            <GradientStop Color="#3000D2FF" Offset="0.3"/>
                            <GradientStop Color="#141E40AF" Offset="0.65"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  MAIN APP LAYOUT                                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Minimal Title Bar (Drag Window) -->
                    <RowDefinition Height="56"/>
                    <!-- Central Content -->
                    <RowDefinition Height="*"/>
                    <!-- Minimal Bottom Status -->
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  TOP BAR (Clean, no clutter, no false badges)           -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Margin="24,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimal Brand with Android ShareDash Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#06B6D4" BlurRadius="14" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>
                            <Path Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.35C15.11,18.56 15.08,18.78 15.08,19A3,3 0 0,0 18.08,22A3,3 0 0,0 21.08,19A3,3 0 0,0 18.08,16.08Z"
                                  Fill="White" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ShareDash" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top Status Badge: Wi-Fi Direct & USB -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101828" BorderBrush="#203450" BorderThickness="1" CornerRadius="15" Padding="14,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#00FFA3" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00FFA3" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="Wi-Fi Direct &amp; USB Active" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Window Control Buttons (Minimize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Minimize_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Content="🗕" Cursor="Hand" FontSize="12" Margin="0,0,4,0"/>
                        <Button Click="Close_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Content="✕" Cursor="Hand" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 1: SCANNING STATE (ON OPEN)                      -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <!-- Radar Pulse Animation -->
                        <RowDefinition Height="220"/>
                        <!-- Scanning Title & Subtext -->
                        <RowDefinition Height="Auto"/>
                        <!-- Discovered Devices List -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Radar Pulse Container -->
                    <Grid Grid.Row="0" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pulse Ring 1 -->
                        <Border x:Name="PulseRing1" Width="96" Height="96" CornerRadius="48" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PulseRing1Scale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Pulse Ring 2 -->
                        <Border x:Name="PulseRing2" Width="96" Height="96" CornerRadius="48" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PulseRing2Scale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Center Apple Glass Dome Node -->
                        <Border Width="76" Height="76" CornerRadius="38" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFA3" BlurRadius="26" Opacity="0.55" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Top Gloss Sheen Reflection -->
                                <Border VerticalAlignment="Top" Height="36" CornerRadius="38,38,0,0" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                                <Path Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.35C15.11,18.56 15.08,18.78 15.08,19A3,3 0 0,0 18.08,22A3,3 0 0,0 21.08,19A3,3 0 0,0 18.08,16.08Z"
                                      Fill="{StaticResource NeonGreenBrush}" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Title & Discoverable Info -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,18">
                        <TextBlock Text="Searching for ShareDash devices..." FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusSubtext}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Discovered Devices: Apple-Style Floating Round Icons -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FloatingRoundDeviceButton}"
                                            Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Center" Width="110" Margin="14,8">
                                            <!-- Circular Glossy Glass Avatar Pod -->
                                            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                <!-- Ambient Glow Aura and Glass Bubble -->
                                                <Border CornerRadius="38" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00FFA3" BlurRadius="20" Opacity="0.45" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <!-- Upper Gloss Sheen Arc -->
                                                        <Border VerticalAlignment="Top" Height="36" CornerRadius="38,38,0,0" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                                                        <!-- Device Icon (Phone / Laptop) -->
                                                        <TextBlock Text="{Binding Icon}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- USB Fast-Path Mini Badge (if USB connected) -->
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#00FFA3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                        Visibility="{Binding HasUsb, Converter={StaticResource BoolToVis}}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00FFA3" BlurRadius="8" Opacity="0.6" ShadowDepth="0"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="⚡" FontSize="13" FontWeight="Bold" Foreground="#040711" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                </Border>
                                            </Grid>

                                            <!-- Device Name -->
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="105" TextAlignment="Center" Margin="0,8,0,3" HorizontalAlignment="Center"/>

                                            <!-- Transport Pill Badge -->
                                            <Border Background="#121D30" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ShortTransport}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource NeonCyanBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 2: CONNECTING ANIMATION                          -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="92" Height="92" CornerRadius="46" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D2FF" BlurRadius="30" Opacity="0.65" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <Border VerticalAlignment="Top" Height="44" CornerRadius="46,46,0,0" Background="{StaticResource GlassSheenBrush}"/>
                                <TextBlock Text="🔗" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ActiveDevice.Name, StringFormat='Connecting to {0}...'}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Exchanging session keys &amp; aggregating channels..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 3: CONNECTED (DRAG FILES TO BE TRANSFERRED)      -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Width="580">
                        <!-- Connected Device Header Pill -->
                        <Border Style="{StaticResource AppleGlassCard}" Margin="0,0,0,16" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#111B2E" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1.2" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding ActiveDevice.Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Connected to " FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ActiveDevice.Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                    <!-- Connected via: <connections: wifi, usb> -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Connected via: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- USB Badge -->
                                        <Border Background="#102A24" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="4,0,6,0"
                                                Visibility="{Binding ActiveDevice.HasUsb, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ USB Fast-Path (3.2 Gbps)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Wi-Fi Badge -->
                                        <Border Background="#121D30" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,6,0"
                                                Visibility="{Binding ActiveDevice.HasWifi, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📶 Wi-Fi Direct (5GHz)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BouncySubtleButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" Height="32" Padding="14,0" FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Large Bubbly Dropzone with Reflective Sheen -->
                        <Border Background="#0E1628" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1.5" CornerRadius="24" Padding="40,48" AllowDrop="True" Drop="Dropzone_Drop" DragOver="Dropzone_DragOver" Cursor="Hand" MouseLeftButtonUp="Dropzone_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFA3" BlurRadius="28" Opacity="0.22" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <TextBlock Text="Drag files to be transferred" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop any file or folder here to share at line speed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,18"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource BouncyPillButton}" Content="Browse Files" Command="{Binding SelectFilesCommand}" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource BouncySubtleButton}" Content="Browse Folder" Command="{Binding SelectFolderCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 4: ACTIVE TRANSFER (SAME AS PHONE SCREEN)        -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource AppleGlassCard}" Width="640" Padding="24,18">
                        <StackPanel HorizontalAlignment="Center" Width="580">
                            <!-- Top Mini Bar: File Name & Cancel -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11" Background="#122538" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="📁" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentFileName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                                    <TextBlock Text="{Binding ActiveDevice.Name, StringFormat='Streaming to {0} at line speed'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BouncySubtleButton}" Content="Cancel" Command="{Binding CancelTransferCommand}" Height="28" Padding="12,0" FontSize="11"/>
                            </Grid>

                            <!-- Main Circular Progress Dashboard (Round Loading Dual-Color) -->
                            <Grid Width="154" Height="154" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <!-- Circular Recessed Background Well -->
                                <Border Width="146" Height="146" CornerRadius="73" Background="#0C1424" BorderBrush="#1C2B44" BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.5" ShadowDepth="2"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Dual-Colored Circular Progress Ring (Cyan = USB, Green = Wi-Fi) -->
                                <ctrl:DualColorProgressRing Width="140" Height="140" StrokeThickness="12"
                                                            UsbProgress="{Binding UsbProgress}"
                                                            WifiProgress="{Binding WifiProgress}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Center Value & Speed Display -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}%'}" FontSize="24" FontWeight="Black" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                                    <Border Background="#122A38" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="0,3,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentSpeedMbS, StringFormat='{}⚡ {0} MB/s'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding EtaTimeFormatted, StringFormat='{}ETA: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- BitTorrent Piece Map / Chunk Visualizer Card (Same as Android PieceGrid) -->
                            <Border Background="#0C1322" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Chunk Map Header -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CHUNK MAP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}">
                                                <Run Text="{Binding CompletedChunksCount, Mode=OneWay}"/>
                                                <Run Text=" of "/>
                                                <Run Text="{Binding TotalChunksCount, Mode=OneWay}"/>
                                                <Run Text=" Chunks Verified"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#142B24" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Sunken Chunk Grid Canvas -->
                                    <Border Background="#080E1A" CornerRadius="9" Height="68" Padding="5" BorderBrush="#142034" BorderThickness="1">
                                        <ctrl:ChunkGridControl ChunkStates="{Binding VisualChunks}" Height="56"/>
                                    </Border>

                                    <!-- Legend Footer -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UsbChunksCount, StringFormat='{}USB ({0})'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#00FFA3" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding WifiChunksCount, StringFormat='{}Wi-Fi ({0})'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#FBBF24" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InFlightChunksCount, StringFormat='{}In-Flight ({0})'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#1E2634" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingChunksCount, StringFormat='{}Pending ({0})'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Channel Speed & Metrics Tiles -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- USB Speed Tile -->
                                <Border Grid.Column="0" Background="#0C1424" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="10,7" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="⚡ USB SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding UsbSpeedMbS, StringFormat='{}{0} MB/s'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Wi-Fi Speed Tile -->
                                <Border Grid.Column="1" Background="#0C1424" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="10,7" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="📶 WI-FI SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding WifiSpeedMbS, StringFormat='{}{0} MB/s'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Peak Speed Tile -->
                                <Border Grid.Column="2" Background="#0C1424" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="10,7" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="PEAK SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding PeakSpeedMbS, StringFormat='{}{0} MB/s'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  STATE 5: COMPLETED STATE                               -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource AppleGlassCard}" Width="480" Padding="34">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="68" Height="68" CornerRadius="34" Background="#102A24" BorderBrush="{StaticResource NeonGreenBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FFA3" BlurRadius="24" Opacity="0.55" ShadowDepth="0"/>
                                </Border.Effect>
                                <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Transfer Complete!" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LatestResult.FileName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                            <!-- Summary Card -->
                            <Border Background="#0E1628" BorderBrush="{StaticResource AppleGlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,22">
                                <Grid Width="380">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="SIZE" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.SizeMb, StringFormat='{}{0:F1} MB'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="TIME" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.TimeSecs, StringFormat='{}{0:F1}s'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="AVG SPEED" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LatestResult.AvgSpeedMbS, StringFormat='{}{0:F1} MB/s'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NeonGreenBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="✓ Integrity Verified with BLAKE3 &amp; CRC32" FontSize="11" Foreground="{StaticResource NeonGreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BouncyPillButton}" Content="Send More Files" Command="{Binding SelectFilesCommand}" Margin="0,0,12,0"/>
                                <Button Style="{StaticResource BouncySubtleButton}" Content="Done" Command="{Binding BackToScanningCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!--  BOTTOM MINIMAL FOOTER                                  -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="28,0">
                    <TextBlock Text="Plug your phone with USB-C cable for faster share." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsUsbPlugged, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  MODAL: CONNECT USB-C FOR MAX SPEED                         -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Panel.ZIndex="1000" Visibility="{Binding IsUsbPromptOpen, Converter={StaticResource BoolToVis}}" Background="#B8040711">
                <Border Width="430" Style="{StaticResource AppleGlassCard}" Background="#111B2C" BorderBrush="{StaticResource AppleGlassBorderBrush}" CornerRadius="26" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00D2FF" BlurRadius="36" Opacity="0.5" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Top Close '✕' Button -->
                        <Button Command="{Binding DismissUsbPromptCommand}" Style="{StaticResource BouncySubtleButton}" Content="✕" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Margin="0,-10,-10,4" FontSize="11"/>

                        <!-- Glowing USB-C Icon Well -->
                        <Border Width="62" Height="62" CornerRadius="31" Background="#0C1B2E" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D2FF" BlurRadius="20" Opacity="0.65" ShadowDepth="0"/>
                            </Border.Effect>
                            <TextBlock Text="⚡" FontSize="28" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="Connect USB-C for Max Speed" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>

                        <!-- Explanation Subtext -->
                        <TextBlock Text="{Binding PendingTargetDevice.Name, StringFormat='You are connecting to {0} over Wi-Fi Direct.'}" FontSize="12" Foreground="{StaticResource NeonCyanBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                        <TextBlock Text="Connect your phone with a USB-C cable to unlock 3.2 Gbps line-speed transfers with zero wireless latency!" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,20" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" LineHeight="17"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Width="360">
                            <Button Style="{StaticResource BouncyPillButton}" Command="{Binding CheckUsbAndConnectCommand}" Margin="0,0,0,10" Height="42">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="I Plugged in USB-C (Turbo)" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BouncySubtleButton}" Command="{Binding ContinueWithWifiCommand}" Content="Continue with Wi-Fi (~30-50 MB/s)" Height="38" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Rust, Kotlin, Web, Markdown, JSON, YAML source files must use LF
*.rs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Binaries and compiled assets
*.exe binary
*.dll binary
*.apk binary
*.aab binary
*.jar binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.db binary
*.db-shm binary
*.db-wal binary
